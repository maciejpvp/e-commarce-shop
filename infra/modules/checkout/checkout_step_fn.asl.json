{
  "Comment": "A description of my state machine",
  "QueryLanguage": "JSONata",
  "StartAt": "Validate Cart",
  "States": {
    "Validate Cart": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.validate_cart}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is Cart Valid"
    },
    "Is Cart Valid": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.statusCode = 200 %}",
          "Next": "Reserve Stock"
        }
      ],
      "Default": "Invalid Cart"
    },
    "Reserve Stock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.reserve_stock}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Check Stock Availability"
    },
    "Check Stock Availability": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Calculate Order Value",
          "Condition": "{% $states.input.statusCode = 200 %}"
        }
      ],
      "Default": "Not Enough Stock"
    },
    "Calculate Order Value": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.calculate_summary}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Create Checkout Session"
    },
    "Create Checkout Session": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.create_session}",
        "Payload": {
          "token": "{% $states.context.Task.Token %}",
          "input": "{% $states.input %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Finalize Order",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Comment": "TimeLimitForayment",
          "Next": "Finalize Order",
          "Output": "{% {\n  \"status\": \"FAILED\",\n  \"processedAt\": $now(),\n  \"data\": $states.input,\n  \"order\": {\n    \"PK\": \"USER#\" & $states.input.body.userId,\n    \"SK\": \"ORDER#\" & $states.input.body.orderId\n  }\n} %}"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CleanUp Order Record"
        }
      ],
      "TimeoutSeconds": 600
    },
    "CleanUp Order Record": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.cleanup}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Fail: Checkout Generation"
    },
    "Fail: Checkout Generation": {
      "Type": "Fail"
    },
    "Finalize Order": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.finalize_order}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Was Order Successful"
    },
    "Was Order Successful": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Send Receipt To Email",
          "Condition": "{% $states.input.status = \"SUCCESS\" %}"
        }
      ],
      "Default": "Un Reserve the Stock"
    },
    "Send Receipt To Email": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.send_receipt}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Payment Accepted"
    },
    "Payment Accepted": {
      "Type": "Succeed"
    },
    "Un Reserve the Stock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${lambda_arns.unreserve_stock}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Payment Declined"
    },
    "Payment Declined": {
      "Type": "Fail"
    },
    "Not Enough Stock": {
      "Type": "Fail"
    },
    "Invalid Cart": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "The cart validation failed or returned a non-200 status."
    }
  }
}